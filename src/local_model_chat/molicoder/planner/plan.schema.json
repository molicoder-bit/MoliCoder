{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "tasks"],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "objective", "risk", "depends_on", "expected_paths", "acceptance_criteria", "verification_checks"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "expected_paths": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "verification_checks": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}}
        }
      }
    }
  }
}
